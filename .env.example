# Caminho dos arquivos JSON exportados pelo Spotify. Padrão: ./spotify_data
SPOTIFY_DATA_DIR=./spotify_data
SPOTIFY_TIME_ZONE=America/Sao_Paulo
# Opcional: banco SQLite local
# SPOTIFY_DB_PATH=./data/spotify.sqlite3
DJANGO_DEBUG=true
# Deixe vazio para uma chave aleatória desta execução; defina uma chave local persistente se necessário.
DJANGO_SECRET_KEY=
